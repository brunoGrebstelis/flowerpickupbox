<footer>
  <div class="footer-content">
    &copy; <span id="year"></span> Flower Shop Automation.
    <span id="i18n-footerRights">{{ t.footerRights }}</span>

    <a href="https://www.instagram.com/flowerpickupbox/" target="_blank" rel="noopener" aria-label="Instagram" class="instagram-link">
      <!-- Accurate Instagram logo: gradient bg + white camera outline -->
      <svg width="22" height="22" viewBox="0 0 256 256" aria-hidden="true">
        <defs>
          <linearGradient id="igGradientFooter" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%"   stop-color="#F58529"/>
            <stop offset="25%"  stop-color="#FEDA77"/>
            <stop offset="50%"  stop-color="#DD2A7B"/>
            <stop offset="75%"  stop-color="#8134AF"/>
            <stop offset="100%" stop-color="#515BD4"/>
          </linearGradient>
        </defs>
        <!-- Rounded square background -->
        <rect x="0" y="0" width="256" height="256" rx="56" fill="url(#igGradientFooter)"/>
        <!-- Camera outer outline -->
        <rect x="64" y="64" width="128" height="128" rx="36" fill="none" stroke="#fff" stroke-width="14"/>
        <!-- Lens -->
        <circle cx="128" cy="128" r="34" fill="none" stroke="#fff" stroke-width="14"/>
        <!-- Viewfinder dot -->
        <circle cx="176" cy="80" r="12" fill="#fff"/>
      </svg>
    </a>
  </div>
</footer>
